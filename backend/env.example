# Server Configuration
PORT=5000

# SQLite Database Configuration
# DB_PATH=./data

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
WORKFLOW_CARD_BASE_URL=http://127.0.0.1:5000

# AI Configuration (Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Speech-to-Text Configuration (Google Cloud)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-service-account-key.json
SPEECH_LANGUAGE_CODE=fa-IR
SPEECH_ENCODING=OGG_OPUS
SPEECH_SAMPLE_RATE=48000
SPEECH_MODEL=default

# Snap API Configuration (optional)
SNAP_API_KEY=your-snap-api-key
SNAP_API_URL=https://api.snap.com

# Email Configuration (SMTP) - برای Email OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com