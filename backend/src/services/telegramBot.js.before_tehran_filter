              { text: '🏷️ تغییر نوع', callback_data: `change_type_center_${centerId}` },
              { text: '👤 اختصاص به کارمند', callback_data: `assign_center_center_${centerId}` }
            ],
            [
              { text: '🔙 بازگشت به لیست', callback_data: 'manage_centers_back' }
