            message += `\nو ${incompleteSnapCost.length - 5} ماموریت دیگر...\n`;
          }

          message += `\n💡 برای تکمیل هزینه اسنپ، از /status_<id> استفاده کنید.`;

          this.conversations.delete(chatId);
