          message += `📋 ماموریت‌های بدون هزینه اسنپ:\n\n`;

          incompleteSnapCost.slice(0, 5).forEach((assignment, index) => {
            const centerName = (assignment.centerName || 'نامشخص').replace(/[*_`\[\]()]/g, '');
            message += `${index + 1}. ماموریت #${assignment.id} - ${centerName}\n`;
