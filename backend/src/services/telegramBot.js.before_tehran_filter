  async showCenterManageDetails(chatId, centerId) {
    try {
      // استفاده از getAll برای دریافت اطلاعات کامل (با JOIN)
      const centers = Center.getAll({});
      const center = centers.find(c => parseInt(c.id) === parseInt(centerId));
      
      if (!center) {
        await this.bot.sendMessage(chatId, '❌ مرکز یافت نشد.');
        return;
      }

      const typeLabels = {
        'lead': '⚪ سرنخ',
        'opportunity': '🟡 فرصت',
        'customer': '🟢 مشتری',
        'old_customer': '🔵 مشتری قدیمی'
      };

      const centerName = (center.name || 'نامشخص').replace(/[*_`\[\]()]/g, '');
      const typeLabel = typeLabels[center.type] || '⚪ سرنخ';
      const responsibleName = center.responsiblePersonnelName ? 
        center.responsiblePersonnelName.replace(/[*_`\[\]()]/g, '') : 'بدون مسئول';
      const address = center.address ? center.address.replace(/[*_`\[\]()]/g, '') : 'ثبت نشده';
