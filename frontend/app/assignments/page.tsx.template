'use client'

import { useState, useEffect } from 'react'
import { getCenters, createCenter, updateCenter, deleteCenter } from '../lib/api'
import Link from 'next/link'

export default function CentersPage() {
  const [centers, setCenters] = useState([])
  const [loading, setLoading] = useState(true)
  const [showForm, setShowForm] = useState(false)
  const [editingCenter, setEditingCenter] = useState<any>(null)

  useEffect(() => {
    fetchCenters()
  }, [])

  const fetchCenters = async () => {
    setLoading(true)
    // Safety timeout - force loading to false after 65 seconds
    const safetyTimeout = setTimeout(() => {
      console.warn('[Centers] Loading timeout - forcing state to false')
      setLoading(false)
    }, 65000)
    
    try {
      console.log('[Centers] Fetching centers...')
      const data = await getCenters()
      console.log('[Centers] Centers loaded:', data?.length || 0)
      setCenters(Array.isArray(data) ? data : [])
    } catch (error: any) {
      console.error('[Centers] Error fetching centers:', error)
      setCenters([])
      if (error.code === 'ECONNABORTED' || error.message?.includes('timeout')) {
        alert('خطا: درخواست به مدت زمان زیادی نیاز دارد. لطفاً دوباره تلاش کنید.')
      } else {
        alert('خطا در دریافت اطلاعات: ' + (error.response?.data?.error || error.message))
      }
    } finally {
      clearTimeout(safetyTimeout)
      setLoading(false)
      console.log('[Centers] Loading finished')
    }
  }

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    const formData = new FormData(e.target as HTMLFormElement)
    const data = {
      name: formData.get('name'),
      address: formData.get('address'),
      latitude: formData.get('latitude') ? parseFloat(formData.get('latitude') as string) : null,
      longitude: formData.get('longitude') ? parseFloat(formData.get('longitude') as string) : null,
      city: formData.get('city') || null,
      district: formData.get('district') || null
    }

    try {
      if (editingCenter) {
        await updateCenter(editingCenter._id, data)
      } else {
        await createCenter(data)
      }
      await fetchCenters()
      setShowForm(false)
      setEditingCenter(null)
    } catch (error: any) {
      alert('خطا: ' + (error.response?.data?.error || error.message))
    }
  }

  const handleDelete = async (id: string) => {
    if (confirm('آیا مطمئن هستید؟')) {
      try {
        await deleteCenter(id)
        await fetchCenters()
      } catch (error: any) {
        alert('خطا: ' + (error.response?.data?.error || error.message))
      }
    }
  }

  return (
    <main className="min-h-screen p-8 bg-gray-50">
      <div className="max-w-6xl mx-auto">
        <div className="flex justify-between items-center mb-8">
          <div>
            <Link href="/" className="text-blue-600 hover:underline mb-2 block">← بازگشت</Link>
            <h1 className="text-4xl font-bold text-gray-800">مدیریت مراکز</h1>
          </div>
          <button
            onClick={() => {
              setEditingCenter(null)
              setShowForm(true)
            }}
            className="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded-lg"
          >
            افزودن مرکز
          </button>
        </div>

        {showForm && (
          <div className="bg-white rounded-lg shadow-md p-6 mb-6">
            <h2 className="text-2xl font-bold mb-4">{editingCenter ? 'ویرایش' : 'افزودن'} مرکز</h2>
            <form onSubmit={handleSubmit}>
              <div className="grid grid-cols-2 gap-4 mb-4">
                <div>
                  <label className="block text-sm font-medium mb-2">نام مرکز *</label>
                  <input type="text" name="name" required defaultValue={editingCenter?.name}
                    className="w-full px-4 py-2 border rounded-lg" />
                </div>
                <div className="col-span-2">
                  <label className="block text-sm font-medium mb-2">آدرس *</label>
                  <input type="text" name="address" required defaultValue={editingCenter?.address}
                    className="w-full px-4 py-2 border rounded-lg" />
                </div>
                <div>
                  <label className="block text-sm font-medium mb-2">عرض جغرافیایی</label>
                  <input type="number" step="any" name="latitude" defaultValue={editingCenter?.latitude}
                    className="w-full px-4 py-2 border rounded-lg" />
                </div>
                <div>
                  <label className="block text-sm font-medium mb-2">طول جغرافیایی</label>
                  <input type="number" step="any" name="longitude" defaultValue={editingCenter?.longitude}
                    className="w-full px-4 py-2 border rounded-lg" />
                </div>
                <div>
                  <label className="block text-sm font-medium mb-2">شهر</label>
                  <input type="text" name="city" defaultValue={editingCenter?.city}
                    className="w-full px-4 py-2 border rounded-lg" />
                </div>
                <div>
                  <label className="block text-sm font-medium mb-2">منطقه</label>
                  <input type="text" name="district" defaultValue={editingCenter?.district}
                    className="w-full px-4 py-2 border rounded-lg" />
                </div>
              </div>
              <div className="flex gap-4">
                <button type="submit" className="bg-blue-500 text-white px-6 py-2 rounded-lg">
                  ذخیره
                </button>
                <button type="button" onClick={() => { setShowForm(false); setEditingCenter(null); }}
                  className="bg-gray-300 px-6 py-2 rounded-lg">
                  انصراف
                </button>
              </div>
            </form>
          </div>
        )}

        {/* Loading Indicator */}
        {loading && (
          <div className="bg-blue-50 border border-blue-200 text-blue-700 px-4 py-3 rounded-lg mb-4 flex items-center gap-3">
            <div className="animate-spin rounded-full h-5 w-5 border-t-2 border-b-2 border-blue-600"></div>
            <span>در حال بارگذاری مراکز...</span>
          </div>
        )}
        
        {/* Centers Table */}
        <div className="bg-white rounded-lg shadow-md overflow-hidden">
          <table className="w-full">
            <thead className="bg-gray-100">
              <tr>
                <th className="px-4 py-3 text-right">نام</th>
                <th className="px-4 py-3 text-right">آدرس</th>
                <th className="px-4 py-3 text-right">شهر</th>
                <th className="px-4 py-3 text-right">عملیات</th>
              </tr>
            </thead>
            <tbody>
              {centers.length === 0 && !loading ? (
                <tr>
                  <td colSpan={4} className="px-4 py-8 text-center text-gray-500">
                    هیچ مرکزی یافت نشد
                  </td>
                </tr>
              ) : (
                centers.map((c: any) => (
                  <tr key={c._id || c.id} className="border-t">
                    <td className="px-4 py-3">{c.name}</td>
                    <td className="px-4 py-3">{c.address}</td>
                    <td className="px-4 py-3">{c.city || '-'}</td>
                    <td className="px-4 py-3">
                      <button onClick={() => { setEditingCenter(c); setShowForm(true); }}
                        className="text-blue-600 hover:underline mr-4">ویرایش</button>
                      <button onClick={() => handleDelete(c._id || c.id)}
                        className="text-red-600 hover:underline">حذف</button>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>
    </main>
  )
}
